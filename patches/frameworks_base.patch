+        if (caps == null) {
+            Log.w(TAG, "No hardware AVC encoder, recording at screen size");
+            return new int[] {screenWidth, screenHeight, refreshRate};
+        }
+
+        final int widthAlign = caps.getWidthAlignment();
+        final int heightAlign = caps.getHeightAlignment();
+        int width = 0;
+        int height = 0;
