+# SamsungDoze is a LineageOS-only app (depends on org.lineageos.platform.internal,
+# absent from a PixelExperience tree). gta4l does not use it — PixelExperience ships
+# its own doze. The module is disabled here so the kati checkbuild of hardware/samsung
+# does not fail on the missing LineageOS dependency. Restore with `git checkout` for a
+# LineageOS build.
+LOCAL_PATH := $(call my-dir)
