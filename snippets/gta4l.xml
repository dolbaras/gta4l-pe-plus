<?xml version="1.0" encoding="UTF-8"?>
<!--
  local_manifest для сборки PixelExperience Plus 11 (Android 11) для Galaxy Tab A7 10.4
  (gta4l / SM-T505, gta4lwifi / SM-T500). Положить в .repo/local_manifests/ после
  `repo init` базы PixelExperience eleven-plus, затем `repo sync`.

  local_manifest for building PixelExperience Plus 11 (Android 11) for the Galaxy Tab A7 10.4
  (gta4l / SM-T505, gta4lwifi / SM-T500). Put it in .repo/local_manifests/ after
  `repo init` of the PixelExperience eleven-plus base, then `repo sync`.
-->
<manifest>
  <remote name="gta4l-gh" fetch="https://github.com/dolbaras/" />

  <!-- Device trees, branch eleven-plus (aosp_* products). -->
  <project path="device/samsung/gta4l"        name="android_device_samsung_gta4l"        remote="gta4l-gh" revision="eleven-plus" />
  <project path="device/samsung/gta4lwifi"    name="android_device_samsung_gta4lwifi"    remote="gta4l-gh" revision="eleven-plus" />

  <!-- The rest is shared with LineageOS 18.1, branch lineage-18.1. -->
  <project path="device/samsung/gta4l-common" name="android_device_samsung_gta4l-common" remote="gta4l-gh" revision="lineage-18.1" />
  <project path="vendor/samsung/gta4l"        name="android_vendor_samsung_gta4l"        remote="gta4l-gh" revision="lineage-18.1" />
  <project path="vendor/samsung/gta4l-common" name="android_vendor_samsung_gta4l-common" remote="gta4l-gh" revision="lineage-18.1" />
  <project path="vendor/samsung/gta4lwifi"    name="android_vendor_samsung_gta4lwifi"    remote="gta4l-gh" revision="lineage-18.1" />
  <project path="kernel/samsung/sm6115"       name="android_kernel_samsung_sm6115"       remote="gta4l-gh" revision="lineage-18.1" />

  <!-- hardware/samsung provides the Samsung keymaster HAL (TARGET_KEYMASTER_VARIANT := samsung).
       It is in the LineageOS manifest but not in PixelExperience's; without it keymaster does not
       start and boot hangs until the watchdog reboots the device. -->
  <remote name="los" fetch="https://github.com/LineageOS/" />
  <project path="hardware/samsung" name="android_hardware_samsung" remote="los" revision="lineage-18.1" />

  <!-- external/faceunlock: the original is on the defunct PixelExperience GitLab, and
       frameworks/base depends on faceunlock_framework, so it comes from the PE archive. -->
  <remove-project name="external_faceunlock" />
  <remote name="pe-archive" fetch="https://github.com/PixelExperienceArchive/" />
  <project path="external/faceunlock" name="external_faceunlock" remote="pe-archive" revision="eleven" />
</manifest>
